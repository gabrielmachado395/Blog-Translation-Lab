# Use "mock" para testar sem gastar chamadas. Use "azure" quando quiser chamar a API real.
TRANSLATION_PROVIDER=mock

# Dados em Azure Portal -> Translator -> Chaves e ponto de extremidade.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Se seu recurso for Global, pode deixar vazio ou "global".
# Se for regional, use o valor da regiao exibido no Azure, por exemplo "eastus".
AZURE_TRANSLATOR_REGION=

# A implementacao inicial usa a API estavel v3.0.
AZURE_TRANSLATOR_API_VERSION=3.0

# Idiomas gerados automaticamente ao publicar.
TARGET_LOCALES=en,es

PORT=3000
